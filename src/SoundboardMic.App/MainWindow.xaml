<Window x:Class="SoundboardMic.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        xmlns:views="clr-namespace:SoundboardMic.App.Views"
        xmlns:vm="clr-namespace:SoundboardMic.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="SoundboardMic" Height="720" Width="1040" MinHeight="560" MinWidth="880"
        WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="True" Background="Transparent"
        FontFamily="{StaticResource AppFont}" Opacity="0">

    <!-- Entrada suave: em vez de "estalar" na tela, a janela some do transparente até o
         estado final (evita o flash abrupto do WindowStyle=None). RenderTransform não é
         suportado em janelas AllowsTransparency+WindowChrome, então animamos só a Opacity. -->
    <Window.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.28" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" />
    </WindowChrome.WindowChrome>

    <Border x:Name="RootBorder" Background="{StaticResource BgBaseBrush}" CornerRadius="12"
            BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Tray -->
            <tb:TaskbarIcon x:Name="Tray" ToolTipText="SoundboardMic"
                            TrayMouseDoubleClick="Tray_DoubleClick">
                <tb:TaskbarIcon.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Abrir SoundboardMic" Click="TrayOpen_Click" FontWeight="SemiBold" />
                        <Separator />
                        <MenuItem Header="Iniciar/Parar injeção" Command="{Binding ToggleEngineCommand}" />
                        <MenuItem Header="Pânico (parar sons)" Command="{Binding PanicoCommand}" />
                        <MenuItem Header="Barra rápida" Command="{Binding AlternarQuickBarCommand}" />
                        <Separator />
                        <MenuItem Header="Sair" Click="TrayExit_Click" />
                    </ContextMenu>
                </tb:TaskbarIcon.ContextMenu>
            </tb:TaskbarIcon>

            <!-- ===================== SIDEBAR ===================== -->
            <Border Grid.Column="0" Background="{StaticResource BgLayerBrush}" CornerRadius="12,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Logo -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="22,26,0,30">
                        <Border Width="42" Height="42" CornerRadius="12" Background="{StaticResource AccentGradientBrush}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="0" Color="#7C5CFF" Opacity="0.6" />
                            </Border.Effect>
                            <TextBlock Text="&#xE720;" Style="{StaticResource Glyph}" FontSize="22" Foreground="White" />
                        </Border>
                        <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                            <TextBlock Text="SoundboardMic" FontSize="16" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="injeção no microfone" FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Navegação -->
                    <StackPanel Grid.Row="1" Margin="14,0">
                        <RadioButton x:Name="NavSons" GroupName="nav" Style="{StaticResource NavButton}"
                                     IsChecked="{Binding MostrandoSons, Mode=OneWay}"
                                     Command="{Binding MostrarSonsCommand}" Tag="&#xE8D6;" Content="Meus sons" />
                        <RadioButton x:Name="NavMyInstants" GroupName="nav" Style="{StaticResource NavButton}"
                                     IsChecked="{Binding MostrandoMyInstants, Mode=OneWay}"
                                     Command="{Binding MostrarMyInstantsCommand}" Tag="&#xE774;" Content="Sons da web"
                                     Margin="0,6,0,0" />
                        <RadioButton x:Name="NavConfig" GroupName="nav" Style="{StaticResource NavButton}"
                                     IsChecked="{Binding MostrandoConfiguracoes, Mode=OneWay}"
                                     Command="{Binding MostrarConfigCommand}" Tag="&#xE713;" Content="Configurações"
                                     Margin="0,6,0,0" />
                    </StackPanel>

                    <!-- Rodapé: status de dispositivo -->
                    <Border Grid.Row="3" Style="{StaticResource Card}" Margin="14,0,14,16" Padding="14,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource IdleBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding EngineRunning}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Injeção parada" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding EngineRunning}" Value="True">
                                                    <Setter Property="Text" Value="Injetando áudio" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <TextBlock Text="{Binding MicDeviceName}" Style="{StaticResource Caption}"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding MicDeviceName}" />
                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                <TextBlock Text="&#xE72A;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                           Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <TextBlock Text="{Binding OutputDeviceName}" Style="{StaticResource Caption}"
                                           TextTrimming="CharacterEllipsis" MaxWidth="150" ToolTip="{Binding OutputDeviceName}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ===================== ÁREA PRINCIPAL ===================== -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Barra de título custom -->
                <Grid Grid.Row="0" Height="44" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseDown">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource IconButton}" Content="&#xE921;" Width="46" Height="34"
                                Click="Minimize_Click" ToolTip="Minimizar" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE922;" Width="46" Height="34"
                                Click="Maximize_Click" ToolTip="Maximizar" />
                        <Button x:Name="BtnClose" Content="&#xE711;" Width="46" Height="34"
                                Click="Close_Click" ToolTip="Fechar" Cursor="Hand"
                                Foreground="{StaticResource TextSecondaryBrush}" FontFamily="{StaticResource IconFont}"
                                FontSize="14" Background="Transparent" BorderThickness="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{StaticResource DangerBrush}" />
                                            <Setter Property="Foreground" Value="White" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Header -->
                <Grid Grid.Row="1" Margin="28,6,20,0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="26">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource H1}">
                                    <Setter Property="Text" Value="Meus sons" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MostrandoMyInstants}" Value="True">
                                            <Setter Property="Text" Value="Sons da web" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding MostrandoConfiguracoes}" Value="True">
                                            <Setter Property="Text" Value="Configurações" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Visibility="{Binding MostrandoSons, Converter={StaticResource BoolToVis}}"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                        <!-- Busca -->
                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="9" Width="220" Height="42" Margin="0,0,10,0"
                                ClipToBounds="True">
                            <Grid>
                                <TextBox Style="{StaticResource AppTextBox}" Background="Transparent" BorderThickness="0"
                                         Padding="38,0,12,0" Text="{Binding Filtro, UpdateSourceTrigger=PropertyChanged}"
                                         VerticalContentAlignment="Center" />
                                <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                           Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"
                                           Margin="14,0,0,0" IsHitTestVisible="False" />
                                <TextBlock Text="Buscar som…" Foreground="{StaticResource TextMutedBrush}"
                                           VerticalAlignment="Center" Margin="38,0,12,0" IsHitTestVisible="False"
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding Filtro, Converter={StaticResource StringToVis}, ConverterParameter=invert}" />
                            </Grid>
                        </Border>

                        <!-- Pânico -->
                        <Button Style="{StaticResource SecondaryButton}" Command="{Binding PanicoCommand}"
                                ToolTip="Parar todos os sons agora" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE71A;" FontFamily="{StaticResource IconFont}" FontSize="15"
                                           Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="Pânico" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Motor on/off -->
                        <Button Style="{StaticResource SecondaryButton}" Command="{Binding ToggleEngineCommand}"
                                Margin="0,0,10,0" ToolTip="Ligar/desligar a injeção">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding EngineButtonGlyph}" FontFamily="{StaticResource IconFont}"
                                           FontSize="15" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding EngineRunning}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding EngineButtonTexto}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Adicionar -->
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding AdicionarAudioCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="15"
                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="Adicionar" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Banner de erro -->
                <Border Grid.Row="2" Margin="28,16,20,0" CornerRadius="10" Background="#3A1F26" Padding="14,10"
                        Visibility="{Binding ErroBanner, Converter={StaticResource StringToVis}}"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE783;" FontFamily="{StaticResource IconFont}" FontSize="15"
                                       Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock Text="{Binding ErroBanner}" Foreground="{StaticResource DangerBrush}"
                                       TextWrapping="Wrap" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Style="{StaticResource IconButton}" Content="&#xE711;" Width="28" Height="28"
                                HorizontalAlignment="Right" Command="{Binding FecharErroCommand}" />
                    </Grid>
                </Border>

                <!-- Conteúdo -->
                <Grid Grid.Row="3" Margin="28,20,20,20">
                    <views:SoundboardView
                        Visibility="{Binding MostrandoSons, Converter={StaticResource BoolToVis}}" />
                    <views:MyInstantsView DataContext="{Binding MyInstants}"
                        Visibility="{Binding DataContext.MostrandoMyInstants, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
                    <views:SettingsView DataContext="{Binding Settings}"
                        Visibility="{Binding DataContext.MostrandoConfiguracoes, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
