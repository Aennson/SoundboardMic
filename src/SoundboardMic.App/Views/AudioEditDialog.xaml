<Window x:Class="SoundboardMic.App.Views.AudioEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SoundboardMic.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:AudioEditViewModel}"
        Title="Editar áudio" Height="840" Width="520"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        FontFamily="{StaticResource AppFont}">

    <Window.Resources>
        <!-- Quadradinho selecionável de glifo -->
        <Style x:Key="IconChoice" TargetType="RadioButton">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Box" CornerRadius="8" Background="{StaticResource BgBaseBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1.5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource CardHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Box" Property="Background" Value="#231F3A" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Bolinha selecionável de cor (Background vem do binding) -->
        <Style x:Key="ColorChoice" TargetType="RadioButton">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="0,0,8,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Ellipse x:Name="Ring" Stroke="Transparent" StrokeThickness="2" Margin="0" />
                            <Ellipse Fill="{TemplateBinding Background}" Margin="4" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource BorderStrongBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource TextPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource BgLayerBrush}" CornerRadius="16"
            BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.55" Color="Black" />
        </Border.Effect>

        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Cabeçalho -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal">
                    <!-- Preview vivo do ícone/cor escolhidos -->
                    <Border Width="42" Height="42" CornerRadius="11"
                            Background="{Binding Cor, Converter={StaticResource HexToBrush}}"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding Icone, Converter={StaticResource CodepointToGlyph}}"
                                   Style="{StaticResource Glyph}" FontSize="20" Foreground="White" />
                    </Border>
                    <TextBlock Text="{Binding Titulo}" Style="{StaticResource H1}" Margin="14,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
                <Button x:Name="BtnClose" Style="{StaticResource IconButton}" Content="&#xE711;"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Click="Fechar_Click"
                        ToolTip="Fechar" />
            </Grid>

            <!-- Conteúdo -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <TextBlock Text="NOME" Style="{StaticResource Caption}" FontWeight="SemiBold" Margin="2,0,0,6" />
                <TextBox Style="{StaticResource AppTextBox}"
                         Text="{Binding Nome, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="ARQUIVO DE ÁUDIO" Style="{StaticResource Caption}" FontWeight="SemiBold"
                           Margin="2,18,0,6" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{StaticResource BgBaseBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="9" Height="42" Padding="14,0">
                        <TextBlock Text="{Binding NomeArquivo}" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                    </Border>
                    <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0"
                            Command="{Binding PickFileCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8E5;" FontFamily="{StaticResource IconFont}" FontSize="15"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="Procurar" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Volume -->
                <Grid Margin="0,18,0,0">
                    <TextBlock Text="VOLUME" Style="{StaticResource Caption}" FontWeight="SemiBold" Margin="2,0,0,6" />
                    <TextBlock Text="{Binding Volume, Converter={StaticResource VolToPercent}}"
                               Style="{StaticResource Caption}" HorizontalAlignment="Right"
                               Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="&#xE767;" FontFamily="{StaticResource IconFont}"
                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"
                               Margin="0,0,12,0" />
                    <Slider Grid.Column="1" Style="{StaticResource AppSlider}" Minimum="0" Maximum="2"
                            Value="{Binding Volume, Mode=TwoWay}" />
                    <Button Grid.Column="2" Style="{StaticResource PlayButton}" Width="40" Height="40" Margin="12,0,0,0"
                            Command="{Binding PreviewCommand}" Content="&#xE768;" ToolTip="Ouvir prévia (nos fones)" />
                </Grid>

                <!-- Ícone e cor (barra rápida) -->
                <TextBlock Text="ÍCONE E COR (BARRA RÁPIDA)" Style="{StaticResource Caption}" FontWeight="SemiBold"
                           Margin="2,20,0,6" />
                <ItemsControl ItemsSource="{Binding Glifos}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton GroupName="IconeAudio" Style="{StaticResource IconChoice}"
                                         ToolTip="{Binding Nome}"
                                         Command="{Binding DataContext.SelecionarIconeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                         CommandParameter="{Binding Codigo}">
                                <RadioButton.IsChecked>
                                    <MultiBinding Converter="{StaticResource IsEqual}" Mode="OneWay">
                                        <Binding Path="DataContext.Icone" RelativeSource="{RelativeSource AncestorType=Window}" />
                                        <Binding Path="Codigo" />
                                    </MultiBinding>
                                </RadioButton.IsChecked>
                                <TextBlock Text="{Binding Codigo, Converter={StaticResource CodepointToGlyph}}"
                                           FontFamily="{StaticResource IconFont}" FontSize="15" />
                            </RadioButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl ItemsSource="{Binding Cores}" Margin="0,6,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton GroupName="CorAudio" Style="{StaticResource ColorChoice}"
                                         ToolTip="{Binding Nome}"
                                         Background="{Binding Hex, Converter={StaticResource HexToBrush}}"
                                         Command="{Binding DataContext.SelecionarCorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                         CommandParameter="{Binding Hex}">
                                <RadioButton.IsChecked>
                                    <MultiBinding Converter="{StaticResource IsEqual}" Mode="OneWay">
                                        <Binding Path="DataContext.Cor" RelativeSource="{RelativeSource AncestorType=Window}" />
                                        <Binding Path="Hex" />
                                    </MultiBinding>
                                </RadioButton.IsChecked>
                            </RadioButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Atalho -->
                <TextBlock Text="ATALHO (TECLA DE DISPARO)" Style="{StaticResource Caption}" FontWeight="SemiBold"
                           Margin="2,20,0,6" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Height="46" CornerRadius="9"
                            Background="{StaticResource BgBaseBrush}" BorderThickness="1.5">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding GravandoAtalho}" Value="True">
                                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                        <Setter Property="Background" Value="#231F3A" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <!-- Texto quando gravando -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="{Binding GravandoAtalho, Converter={StaticResource BoolToVis}}">
                                <Ellipse Width="9" Height="9" Fill="{StaticResource DangerBrush}" Margin="0,0,8,0">
                                    <Ellipse.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     From="1" To="0.2" Duration="0:0:0.7" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Ellipse.Triggers>
                                </Ellipse>
                                <TextBlock Text="Pressione a combinação…" Foreground="{StaticResource TextPrimaryBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <!-- Chip do atalho quando não gravando -->
                            <Grid Visibility="{Binding GravandoAtalho, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                                <Border Background="{StaticResource CardHoverBrush}" CornerRadius="7" Padding="12,5"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="{Binding Teclas, Converter={StaticResource StringToVis}}">
                                    <TextBlock Text="{Binding Teclas}" Foreground="{StaticResource TextPrimaryBrush}"
                                               FontWeight="SemiBold" FontSize="14" />
                                </Border>
                                <TextBlock Text="Nenhum atalho definido" Foreground="{StaticResource TextMutedBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Teclas}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Grid>
                    </Border>

                    <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Height="46" Margin="10,0,0,0"
                            Command="{Binding ToggleGravacaoCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE765;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Gravar" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding GravandoAtalho}" Value="True">
                                                <Setter Property="Text" Value="Cancelar" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="46" Height="46" Margin="6,0,0,0"
                            Content="&#xE74D;" Command="{Binding LimparAtalhoCommand}" ToolTip="Remover atalho" />
                </Grid>

                <!-- Atalho ativo/inativo (antes ficava na lista, agora só se edita aqui) -->
                <Grid Margin="2,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ToggleButton Grid.Column="0" Style="{StaticResource ToggleSwitchSmall}"
                                  VerticalAlignment="Center" IsChecked="{Binding Ativo, Mode=TwoWay}" />
                    <TextBlock Grid.Column="1" Text="Atalho ativo" Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="13" VerticalAlignment="Center" Margin="10,0,0,0" />
                </Grid>

                <!-- Erro -->
                <Border Background="#3A1F26" CornerRadius="9" Padding="14,10" Margin="0,16,0,0"
                        Visibility="{Binding Erro, Converter={StaticResource StringToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE783;" FontFamily="{StaticResource IconFont}" FontSize="15"
                                   Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBlock Text="{Binding Erro}" Foreground="{StaticResource DangerBrush}"
                                   TextWrapping="Wrap" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>
            </ScrollViewer>

            <!-- Rodapé: cancelar · excluir (só ao editar) · salvar -->
            <Grid Grid.Row="2" Margin="0,24,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Style="{StaticResource SecondaryButton}" Content="Cancelar"
                        HorizontalAlignment="Left" Width="120" Click="Fechar_Click" />
                <Button Grid.Column="1" Style="{StaticResource IconButtonDanger}" Width="46" Height="46"
                        Margin="0,0,10,0" Content="&#xE74D;" ToolTip="Excluir áudio"
                        Visibility="{Binding IsEdicao, Converter={StaticResource BoolToVis}}"
                        Command="{Binding ExcluirCommand}" />
                <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}"
                        Width="150">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74E;" FontFamily="{StaticResource IconFont}" FontSize="15"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="Salvar" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
