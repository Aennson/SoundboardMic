<UserControl x:Class="SoundboardMic.App.Views.EditorDeSonsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SoundboardMic.App.ViewModels"
             xmlns:controls="clr-namespace:SoundboardMic.App.Controls"
             mc:Ignorable="d" d:DesignHeight="640" d:DesignWidth="820"
             d:DataContext="{d:DesignInstance vm:EditorDeSonsViewModel}"
             FontFamily="{StaticResource AppFont}">

    <UserControl.Resources>
        <!-- Linha da lista de áudios: ícone/cor + nome + categoria + duração -->
        <Style x:Key="EditorListItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisualStyle}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Nome}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource CardHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#231F3A" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TempoTextBox" TargetType="TextBox" BasedOn="{StaticResource AppTextBox}">
            <Setter Property="Width" Value="104" />
            <Setter Property="Height" Value="36" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="Consolas, Segoe UI" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="120" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Busca -->
        <Border Grid.Row="0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="9" Height="42" Width="320" HorizontalAlignment="Left"
                Margin="0,0,0,12">
            <Grid ClipToBounds="True">
                <TextBox x:Name="Busca" Style="{StaticResource AppTextBox}" Background="Transparent" BorderThickness="0"
                         Padding="38,0,12,0" VerticalContentAlignment="Center"
                         AutomationProperties.Name="Buscar áudio por nome"
                         Text="{Binding Busca, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="14"
                           Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"
                           Margin="14,0,0,0" IsHitTestVisible="False" />
                <TextBlock Text="Buscar em Meus sons…" Foreground="{StaticResource TextMutedBrush}"
                           VerticalAlignment="Center" Margin="38,0,12,0" IsHitTestVisible="False"
                           Visibility="{Binding Busca, Converter={StaticResource StringToVis}, ConverterParameter=invert}" />
            </Grid>
        </Border>

        <!-- Lista de áudios -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8" Margin="0,0,0,14">
            <Grid>
                <ListBox x:Name="Lista" ItemsSource="{Binding AudiosView}" SelectedItem="{Binding Selecionado}"
                         Background="Transparent" BorderThickness="0" Padding="0"
                         ItemContainerStyle="{StaticResource EditorListItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         AutomationProperties.Name="Áudios para editar"
                         Visibility="{Binding SemAudios, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:AudioItemViewModel}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="28" Height="28" CornerRadius="8"
                                        Background="{Binding Cor, Converter={StaticResource HexToBrush}}">
                                    <TextBlock Text="{Binding Icone, Converter={StaticResource CodepointToGlyph}}"
                                               Style="{StaticResource Glyph}" FontSize="13" Foreground="White" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Nome}" Foreground="{StaticResource TextPrimaryBrush}"
                                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding CategoriaNome}" Style="{StaticResource Caption}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding DuracaoTexto}" Style="{StaticResource Caption}"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Estado vazio -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding SemAudios, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="&#xE8C6;" Style="{StaticResource Glyph}" FontSize="28"
                               Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="Nenhum som para editar" Style="{StaticResource H2}" Margin="0,10,0,4"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Adicione sons em &quot;Meus sons&quot; para cortá-los aqui." Style="{StaticResource Caption}"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Editor do áudio selecionado -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="18,16">
            <Grid>
                <TextBlock Text="Selecione um áudio na lista acima para ver a forma de onda e escolher o trecho."
                           Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,30"
                           Visibility="{Binding TemSelecionado, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />

                <StackPanel Visibility="{Binding TemSelecionado, Converter={StaticResource BoolToVis}}">
                    <!-- Cabeçalho -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Selecionado.Nome}" Style="{StaticResource H2}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Style="{StaticResource Caption}" VerticalAlignment="Center">
                            <Run Text="Duração total" />
                            <Run Text="{Binding DuracaoTotalTexto, Mode=OneWay}" />
                        </TextBlock>
                    </Grid>

                    <!-- Forma de onda -->
                    <Border Background="{StaticResource BgBaseBrush}" CornerRadius="8" Padding="8,8,8,4" Height="150">
                        <Grid>
                            <controls:WaveformView x:Name="Onda"
                                                   Picos="{Binding Picos}"
                                                   Duracao="{Binding Duracao}"
                                                   Inicio="{Binding Inicio, Mode=TwoWay}"
                                                   Fim="{Binding Fim, Mode=TwoWay}"
                                                   CursorPosicao="{Binding Cursor}"
                                                   OndaBrush="{StaticResource AccentBrush}"
                                                   TextoBrush="{StaticResource TextMutedBrush}" />
                            <TextBlock Text="Carregando forma de onda…" Style="{StaticResource Caption}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding CarregandoOnda, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </Border>

                    <!-- Trecho + pré-escuta -->
                    <WrapPanel Margin="0,12,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,8">
                            <TextBlock Text="Início" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Style="{StaticResource TempoTextBox}" AutomationProperties.Name="Início do trecho"
                                     ToolTip="m:ss.mmm — Enter para aplicar"
                                     Text="{Binding InicioTexto}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,8">
                            <TextBlock Text="Fim" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Style="{StaticResource TempoTextBox}" AutomationProperties.Name="Fim do trecho"
                                     ToolTip="m:ss.mmm — Enter para aplicar"
                                     Text="{Binding FimTexto}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,16,8">
                            <Run Text="Trecho:" />
                            <Run Text="{Binding DuracaoSelecaoTexto, Mode=OneWay}" Foreground="{StaticResource TextPrimaryBrush}"
                                 FontWeight="SemiBold" />
                        </TextBlock>
                        <Button Style="{StaticResource SecondaryButton}" Command="{Binding SelecionarTudoCommand}"
                                Margin="0,0,10,8" AutomationProperties.Name="Selecionar tudo">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8B3;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="Selecionar tudo" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SecondaryButton}" Command="{Binding OuvirSelecaoCommand}"
                                Margin="0,0,0,8" AutomationProperties.Name="Ouvir seleção"
                                ToolTip="Toca só o trecho selecionado nos fones (monitoramento)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding OuvirGlifo}" FontFamily="{StaticResource IconFont}" FontSize="14"
                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding OuvirTexto}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>

                    <!-- Salvar -->
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" MaxWidth="320" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Nome do novo áudio" Style="{StaticResource Caption}" VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <TextBox Grid.Column="1" Style="{StaticResource AppTextBox}" Height="36"
                                 VerticalContentAlignment="Center"
                                 AutomationProperties.Name="Nome do novo áudio"
                                 Text="{Binding NomeNovo, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Command="{Binding CriarNovoCommand}"
                                Margin="10,0,0,0" AutomationProperties.Name="Criar novo áudio">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="Criar novo áudio" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="3" Style="{StaticResource SecondaryButton}" Command="{Binding SubstituirCommand}"
                                Margin="10,0,0,0" AutomationProperties.Name="Substituir original"
                                ToolTip="Sobrescreve o áudio original (não pode ser desfeito)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE777;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                           Foreground="{StaticResource DangerBrush}"
                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="Substituir original" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Feedback -->
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="Salvando…" Style="{StaticResource Caption}"
                                   Visibility="{Binding Ocupado, Converter={StaticResource BoolToVis}}" />
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding Mensagem, Converter={StaticResource StringToVis}}">
                            <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                       Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding Mensagem}" Foreground="{StaticResource SuccessBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
