<Window x:Class="SoundboardMic.App.Views.QuickBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SoundboardMic.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:QuickBarViewModel}"
        Title="Barra rápida"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight" Focusable="False"
        FontFamily="{StaticResource AppFont}">

    <Border Background="{StaticResource FluentSurfaceBrush}"
            BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
        CornerRadius="{StaticResource CornerCard}" Padding="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.55" Color="Black" />
        </Border.Effect>
        <Border.ContextMenu>
            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                <MenuItem Header="Horizontal" IsChecked="{Binding Horizontal, Mode=OneWay}"
                          Command="{Binding ModoHorizontalCommand}" />
                <MenuItem Header="Vertical" IsChecked="{Binding Horizontal, Converter={StaticResource InverseBool}, Mode=OneWay}"
                          Command="{Binding ModoVerticalCommand}" />
                <Separator />
                <MenuItem Header="Abrir SoundboardMic" Command="{Binding AbrirJanelaPrincipalCommand}" />
                <MenuItem Header="Ocultar barra" Command="{Binding OcultarCommand}" />
            </ContextMenu>
        </Border.ContextMenu>

        <StackPanel Orientation="{Binding Orientacao}">

            <!-- Alça de arrasto -->
            <Border x:Name="DragHandle" Background="Transparent" Cursor="SizeAll"
                    MouseLeftButtonDown="DragHandle_MouseLeftButtonDown"
                    ToolTip="Arraste para mover · botão direito para opções"
                    AutomationProperties.Name="Alça para mover a barra rápida">
                <TextBlock Text="&#xE712;" FontFamily="{StaticResource IconFont}" FontSize="12"
                           Foreground="{StaticResource TextMutedBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4" />
            </Border>

            <!-- Um botão por áudio -->
            <ItemsControl ItemsSource="{Binding AudiosView}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="{Binding DataContext.Orientacao, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource QuickBarButton}"
                                Width="{Binding DataContext.TamanhoBotao, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                Height="{Binding DataContext.TamanhoBotao, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                Background="{Binding Cor, Converter={StaticResource HexToBrush}}"
                                Content="{Binding Icone, Converter={StaticResource CodepointToGlyph}}"
                                ToolTip="{Binding Nome}"
                                AutomationProperties.Name="{Binding Nome}"
                                Command="{Binding DataContext.TocarCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Pânico discreto -->
            <Button Style="{StaticResource IconButtonDanger}" Width="26" Height="26" FontSize="11"
                    Margin="2" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Content="&#xE71A;" Foreground="{StaticResource TextMutedBrush}"
                    Command="{Binding PanicoCommand}" ToolTip="Parar todos os sons"
                    AutomationProperties.Name="Parar todos os sons" />
        </StackPanel>
    </Border>
</Window>
