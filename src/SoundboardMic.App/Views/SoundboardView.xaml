<UserControl x:Class="SoundboardMic.App.Views.SoundboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SoundboardMic.App.ViewModels"
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="820"
             FontFamily="{StaticResource AppFont}">

    <Grid>
        <!-- Lista de sons -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <ItemsControl ItemsSource="{Binding Audios}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:AudioItemViewModel}">
                        <Border Margin="0,0,0,12" CornerRadius="14" BorderThickness="1" Padding="14,12">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource CardBrush}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{StaticResource CardHoverBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding Tocando}" Value="True">
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Play -->
                                <Button Grid.Column="0" Style="{StaticResource PlayButton}" Content="&#xE768;"
                                        VerticalAlignment="Center"
                                        Command="{Binding DataContext.TocarAudioCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" ToolTip="Testar (injeta no mix)" />

                                <!-- Nome + arquivo -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0">
                                    <TextBlock Text="{Binding Nome}" FontSize="15" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                        <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                                   Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding NomeArquivo}" Style="{StaticResource Caption}"
                                                   Margin="6,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="220" />
                                        <Border Width="3" Height="3" CornerRadius="2" Background="{StaticResource TextMutedBrush}"
                                                Margin="8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding DuracaoTexto}" Style="{StaticResource Caption}" />
                                        <Border Width="3" Height="3" CornerRadius="2" Background="{StaticResource TextMutedBrush}"
                                                Margin="8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding VolumeTexto}" Style="{StaticResource Caption}" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Chip de atalho -->
                                <Border Grid.Column="2" VerticalAlignment="Center" Margin="8,0" CornerRadius="8"
                                        MinWidth="96" Height="34" Padding="12,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#231F3A" />
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TemAtalho}" Value="False">
                                                    <Setter Property="Background" Value="{StaticResource BgBaseBrush}" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding TemAtalho, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="&#xE765;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                                       Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"
                                                       Margin="0,0,7,0" />
                                            <TextBlock Text="{Binding Teclas}" Foreground="{StaticResource TextPrimaryBrush}"
                                                       FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="sem atalho" Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Visibility="{Binding TemAtalho, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                                    </Grid>
                                </Border>

                                <!-- Toggle ativo -->
                                <ToggleButton Grid.Column="3" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                              Margin="8,0" IsChecked="{Binding Ativo, Mode=TwoWay}"
                                              Command="{Binding DataContext.AlternarAtivoCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                              CommandParameter="{Binding}"
                                              ToolTip="Ativar/desativar o atalho" />

                                <!-- Editar -->
                                <Button Grid.Column="4" Style="{StaticResource IconButton}" Content="&#xE70F;"
                                        VerticalAlignment="Center"
                                        Command="{Binding DataContext.EditarAudioCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" ToolTip="Editar" />

                                <!-- Excluir -->
                                <Button Grid.Column="5" Style="{StaticResource IconButtonDanger}" Content="&#xE74D;"
                                        VerticalAlignment="Center"
                                        Command="{Binding DataContext.ExcluirAudioCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" ToolTip="Excluir" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Estado vazio -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{Binding ListaVazia, Converter={StaticResource BoolToVis}}">
            <Border Width="96" Height="96" CornerRadius="24" Background="{StaticResource CardBrush}"
                    HorizontalAlignment="Center">
                <TextBlock Text="&#xE8D6;" Style="{StaticResource Glyph}" FontSize="44"
                           Foreground="{StaticResource TextMutedBrush}" />
            </Border>
            <TextBlock Text="Nenhum áudio cadastrado" Style="{StaticResource H2}" HorizontalAlignment="Center"
                       Margin="0,20,0,6" />
            <TextBlock Text="Adicione seu primeiro som para começar a montar o soundboard."
                       Style="{StaticResource Caption}" HorizontalAlignment="Center" MaxWidth="320"
                       TextAlignment="Center" TextWrapping="Wrap" />
            <Button Style="{StaticResource PrimaryButton}" Command="{Binding AdicionarAudioCommand}"
                    HorizontalAlignment="Center" Margin="0,20,0,0" Width="180">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="15"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="Adicionar áudio" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
