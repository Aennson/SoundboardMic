<UserControl x:Class="SoundboardMic.App.Views.SoundboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SoundboardMic.App.ViewModels"
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="820"
             FontFamily="{StaticResource AppFont}">

    <Grid>
        <!-- Grade de cards de som (responsiva: reflui automaticamente conforme a largura) -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <ItemsControl ItemsSource="{Binding Audios}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:AudioItemViewModel}">
                        <!-- Card: largura fixa ~134px → 5 por linha na largura padrão da janela -->
                        <Border Style="{StaticResource SoundCard}" Width="134" Margin="0,0,12,12" Padding="12,12,12,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Cabeçalho: ícone/cor do áudio + toggle de atalho ativo -->
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Ícone do card = mesmo ícone/cor escolhidos no editor -->
                                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10"
                                            Background="{Binding Cor, Converter={StaticResource HexToBrush}}">
                                        <TextBlock Text="{Binding Icone, Converter={StaticResource CodepointToGlyph}}"
                                                   Style="{StaticResource Glyph}" FontSize="16" Foreground="White" />
                                    </Border>

                                    <ToggleButton Grid.Column="2" Style="{StaticResource ToggleSwitchSmall}"
                                                  VerticalAlignment="Top" HorizontalAlignment="Right"
                                                  IsChecked="{Binding Ativo, Mode=TwoWay}"
                                                  Command="{Binding DataContext.AlternarAtivoCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                  CommandParameter="{Binding}"
                                                  ToolTip="Ativar/desativar o atalho" />
                                </Grid>

                                <!-- Nome -->
                                <TextBlock Grid.Row="1" Text="{Binding Nome}" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap" Margin="0,10,0,0" ToolTip="{Binding Nome}" />

                                <!-- Arquivo -->
                                <TextBlock Grid.Row="2" Text="{Binding NomeArquivo}" Style="{StaticResource Caption}"
                                           Margin="0,2,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding NomeArquivo}" />

                                <!-- Duração + volume -->
                                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding DuracaoTexto}" Style="{StaticResource Caption}" />
                                    <Border Width="3" Height="3" CornerRadius="2" Background="{StaticResource TextMutedBrush}"
                                            Margin="6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding VolumeTexto}" Style="{StaticResource Caption}" />
                                </StackPanel>

                                <!-- Chip de atalho -->
                                <Border Grid.Row="4" VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                                        Margin="0,8,0,10" CornerRadius="8" Height="30" Padding="8,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#231F3A" />
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TemAtalho}" Value="False">
                                                    <Setter Property="Background" Value="{StaticResource BgBaseBrush}" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding TemAtalho, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="&#xE765;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                                       Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"
                                                       Margin="0,0,6,0" />
                                            <TextBlock Text="{Binding Teclas}" Foreground="{StaticResource TextPrimaryBrush}"
                                                       FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Text="sem atalho" Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Visibility="{Binding TemAtalho, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                                    </Grid>
                                </Border>

                                <!-- Ações: play/stop em destaque + editar/excluir -->
                                <Grid Grid.Row="5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0" Style="{StaticResource PlayStopButton}" Width="36" Height="36"
                                            FontSize="14" HorizontalAlignment="Left"
                                            Command="{Binding DataContext.TocarAudioCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />

                                    <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE70F;"
                                            Width="30" Height="30" FontSize="14" VerticalAlignment="Center"
                                            Command="{Binding DataContext.EditarAudioCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" ToolTip="Editar" />

                                    <Button Grid.Column="2" Style="{StaticResource IconButtonDanger}" Content="&#xE74D;"
                                            Width="30" Height="30" FontSize="14" VerticalAlignment="Center"
                                            Command="{Binding DataContext.ExcluirAudioCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" ToolTip="Excluir" />
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Estado vazio -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{Binding ListaVazia, Converter={StaticResource BoolToVis}}">
            <Border Width="96" Height="96" CornerRadius="24" Background="{StaticResource CardBrush}"
                    HorizontalAlignment="Center">
                <TextBlock Text="&#xE8D6;" Style="{StaticResource Glyph}" FontSize="44"
                           Foreground="{StaticResource TextMutedBrush}" />
            </Border>
            <TextBlock Text="Nenhum áudio cadastrado" Style="{StaticResource H2}" HorizontalAlignment="Center"
                       Margin="0,20,0,6" />
            <TextBlock Text="Adicione seu primeiro som para começar a montar o soundboard."
                       Style="{StaticResource Caption}" HorizontalAlignment="Center" MaxWidth="320"
                       TextAlignment="Center" TextWrapping="Wrap" />
            <Button Style="{StaticResource PrimaryButton}" Command="{Binding AdicionarAudioCommand}"
                    HorizontalAlignment="Center" Margin="0,20,0,0" Width="180">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="15"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="Adicionar áudio" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
