<UserControl x:Class="SoundboardMic.App.Views.SoundboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SoundboardMic.App.ViewModels"
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="820"
             FontFamily="{StaticResource AppFont}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Rota de áudio: mantém a origem e o destino sempre visíveis antes dos cards. -->
        <Border Grid.Row="0" Margin="0,0,8,16" Padding="14,10"
                Background="{StaticResource FluentSurfaceActiveBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="{StaticResource CornerControl}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="ROTA DE ÁUDIO" Style="{StaticResource Caption}"
                               FontWeight="SemiBold" Foreground="{StaticResource FluentAccentBrush}" />
                    <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                        <Border Padding="8,4" Background="{StaticResource BgBaseBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="{StaticResource CornerControl}">
                            <TextBlock Text="{Binding MicDeviceName}" Foreground="{StaticResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis" MaxWidth="170" />
                        </Border>
                        <TextBlock Text="&#xE72A;" Style="{StaticResource Glyph}" FontSize="12"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="8,0" />
                        <Border Padding="8,4" Background="{StaticResource BgBaseBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="{StaticResource CornerControl}">
                            <TextBlock Text="{Binding OutputDeviceName}" Foreground="{StaticResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis" MaxWidth="170" />
                        </Border>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="16,0,0,0">
                    <Ellipse Width="8" Height="8" Margin="0,0,7,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CableDetected}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="12">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="VB-Cable não encontrado" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CableDetected}" Value="True">
                                        <Setter Property="Text" Value="CABLE Input pronto" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Grade de cards de som, agrupada em seções por categoria (cada categoria ocupa
             uma linha inteira e cresce para baixo; responsiva via WrapPanel interno). -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <ItemsControl ItemsSource="{Binding Grupos}"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.ScrollUnit="Pixel">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel Orientation="Vertical" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:CategoriaGroupViewModel}">
                        <StackPanel Margin="0,0,0,22">
                            <!-- Cabeçalho da categoria: nome + reordenar (oculto em "sem categoria") -->
                            <Grid Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Nome}" Style="{StaticResource H2}" />
                                    <Border Background="{StaticResource CardBrush}" CornerRadius="8" Padding="8,2"
                                            Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Itens.Count}" Style="{StaticResource Caption}" />
                                    </Border>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                            Visibility="{Binding SemCategoria, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                                    <Button Style="{StaticResource IconButton}" Content="&#xE70E;" Width="28" Height="28"
                                            FontSize="11"
                                            AutomationProperties.Name="Mover categoria para cima"
                                            Command="{Binding DataContext.MoverCategoriaAcimaCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                            CommandParameter="{Binding}" ToolTip="Mover categoria para cima" />
                                    <Button Style="{StaticResource IconButton}" Content="&#xE70D;" Width="28" Height="28"
                                            FontSize="11" Margin="4,0,0,0"
                                            AutomationProperties.Name="Mover categoria para baixo"
                                            Command="{Binding DataContext.MoverCategoriaAbaixoCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                            CommandParameter="{Binding}" ToolTip="Mover categoria para baixo" />
                                </StackPanel>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding Itens}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <!-- Entrada suave: cada card nasce invisível/deslocado e some para o lugar (efeito "lazy load"). -->
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Opacity" Value="0" />
                                        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                                        <Setter Property="RenderTransform">
                                            <Setter.Value>
                                                <TranslateTransform Y="14" />
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         From="0" To="1" Duration="0:0:0.32" />
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                                         From="14" To="0" Duration="0:0:0.32">
                                                            <DoubleAnimation.EasingFunction>
                                                                <QuadraticEase EasingMode="EaseOut" />
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:AudioItemViewModel}">
                                        <!-- Card: largura fixa ~134px → 5 por linha na largura padrão da janela -->
                                        <Border Style="{StaticResource SoundCard}" Width="134" Margin="0,0,12,12" Padding="12,12,12,10">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <!-- Cabeçalho: ícone/cor do áudio + mover + editar -->
                                                <Grid Grid.Row="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Ícone do card = mesmo ícone/cor escolhidos no editor -->
                                                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10"
                                                            Background="{Binding Cor, Converter={StaticResource HexToBrush}}">
                                                        <TextBlock Text="{Binding Icone, Converter={StaticResource CodepointToGlyph}}"
                                                                   Style="{StaticResource Glyph}" FontSize="16" Foreground="White" />
                                                    </Border>

                                                    <!-- Mover dentro da categoria -->
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                                        <Button Style="{StaticResource IconButton}" Content="&#xE70E;"
                                                                Width="24" Height="24" FontSize="9"
                                                                AutomationProperties.Name="Mover áudio para cima"
                                                                Command="{Binding DataContext.MoverAudioAcimaCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                                CommandParameter="{Binding}" ToolTip="Mover para cima" />
                                                        <Button Style="{StaticResource IconButton}" Content="&#xE70D;"
                                                                Width="24" Height="24" FontSize="9" Margin="2,0,0,0"
                                                                AutomationProperties.Name="Mover áudio para baixo"
                                                                Command="{Binding DataContext.MoverAudioAbaixoCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                                CommandParameter="{Binding}" ToolTip="Mover para baixo" />
                                                        <Button Style="{StaticResource IconButton}" Content="&#xE70F;"
                                                                Width="24" Height="24" FontSize="12" Margin="2,0,0,0"
                                                                AutomationProperties.Name="Editar áudio"
                                                                Command="{Binding DataContext.EditarAudioCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                                CommandParameter="{Binding}" ToolTip="Editar" />
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Nome -->
                                                <TextBlock Grid.Row="1" Text="{Binding Nome}" FontSize="14" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"
                                                           TextWrapping="NoWrap" Margin="0,10,0,0" ToolTip="{Binding Nome}" />

                                                <!-- Duração + volume -->
                                                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,4,0,0">
                                                    <TextBlock Text="{Binding DuracaoTexto}" Style="{StaticResource Caption}" />
                                                    <Border Width="3" Height="3" CornerRadius="2" Background="{StaticResource TextMutedBrush}"
                                                            Margin="6,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding VolumeTexto}" Style="{StaticResource Caption}" />
                                                </StackPanel>

                                                <!-- Chip de atalho -->
                                                <Border Grid.Row="3" VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                                                        Margin="0,8,0,10" CornerRadius="8" Height="30" Padding="8,0">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#231F3A" />
                                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                            <Setter Property="BorderThickness" Value="1" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding TemAtalho}" Value="False">
                                                                    <Setter Property="Background" Value="{StaticResource BgBaseBrush}" />
                                                                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Grid>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"
                                                                    Visibility="{Binding TemAtalho, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="&#xE765;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                                                       Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"
                                                                       Margin="0,0,6,0" />
                                                            <TextBlock Text="{Binding Teclas}" Foreground="{StaticResource TextPrimaryBrush}"
                                                                       FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <TextBlock Text="sem atalho" Foreground="{StaticResource TextMutedBrush}"
                                                                   FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Visibility="{Binding TemAtalho, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                                                    </Grid>
                                                </Border>

                                                <!-- Ações: tocar (sempre dispara uma nova instância) e parar (interrompe esta) -->
                                                <Grid Grid.Row="4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="8" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <Button Grid.Column="0" Style="{StaticResource PlayButton}" Width="36" Height="36"
                                                            FontSize="14" HorizontalAlignment="Center" Content="&#xE768;"
                                                            AutomationProperties.Name="Tocar áudio"
                                                            Command="{Binding DataContext.TocarAudioCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                            CommandParameter="{Binding}" ToolTip="Tocar (nova instância)" />

                                                    <Button Grid.Column="2" Style="{StaticResource StopButton}" Width="36" Height="36"
                                                            FontSize="13" HorizontalAlignment="Center"
                                                            AutomationProperties.Name="Parar áudio"
                                                            Command="{Binding DataContext.PararAudioCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                            CommandParameter="{Binding}" ToolTip="Parar este som" />
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Estado vazio -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{Binding ListaVazia, Converter={StaticResource BoolToVis}}">
            <Border Width="96" Height="96" CornerRadius="24" Background="{StaticResource CardBrush}"
                    HorizontalAlignment="Center">
                <TextBlock Text="&#xE8D6;" Style="{StaticResource Glyph}" FontSize="44"
                           Foreground="{StaticResource TextMutedBrush}" />
            </Border>
            <TextBlock Text="Nenhum áudio cadastrado" Style="{StaticResource H2}" HorizontalAlignment="Center"
                       Margin="0,20,0,6" />
            <TextBlock Text="Adicione seu primeiro som para começar a montar o soundboard."
                       Style="{StaticResource Caption}" HorizontalAlignment="Center" MaxWidth="320"
                       TextAlignment="Center" TextWrapping="Wrap" />
            <Button Style="{StaticResource PrimaryButton}" Command="{Binding AdicionarAudioCommand}"
                    HorizontalAlignment="Center" Margin="0,20,0,0" Width="180"
                    AutomationProperties.Name="Adicionar áudio">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="15"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="Adicionar áudio" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
